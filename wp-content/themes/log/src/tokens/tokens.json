{
  "$about": "The one source for LOG's design values. `npm run tokens` (also run before every build) writes src/styles/tokens.gen.css, src/tokens/tokens.js and the colors block of DESIGN.md. Edit values here, never in the generated files. Keys are the CSS custom property names without the leading --.",

  "color": {
    "plate": { "value": "#13212f", "note": "night ground: the map, the control company, the footer" },
    "plate-2": "#1b2c3d",
    "plate-line": "#3a4e62",
    "plate-deep": "#0b131b",
    "legend": { "value": "#f2f4f1", "note": "text on night" },
    "legend-muted": "#a3b3bf",
    "paper": { "value": "#e7eae6", "note": "day ground of reading pages" },
    "paper-2": "#f4f5f2",
    "ink": "#15202b",
    "slate": "#53606a",
    "rule": "#b8c0c2",
    "rule-soft": "#d3d8d6",
    "night-rule-soft": { "value": "#2a3d50", "note": "rule-soft inside night worlds (the token swap in pages.css)" },
    "works": { "value": "#f7931d", "note": "LOG orange: active work, hover, focus" },
    "works-deep": { "value": "#b9650a", "note": "orange that has to read as small text on paper" },
    "sign-ink": "#15202b",
    "danger": "#b3261e"
  },

  "map": {
    "map-fog": "#1d2a3a",
    "map-sea": "#2f4a63",
    "map-building-face": "#3a4858",
    "map-road-national": "#9db1c6",
    "map-road-regional": "#b4c4d4",
    "map-road": "#e3ebf2",
    "map-road-major": "#ffffff"
  },

  "hair": {
    "hair": { "value": "rgba(242, 244, 241, .16)", "note": "hairlines on night" },
    "hair-strong": "rgba(242, 244, 241, .38)",
    "hair-ink": { "value": "rgba(21, 32, 43, .16)", "note": "hairlines on paper" }
  },

  "font": {
    "font-display": "'Ploni Tzar', 'Ploni', system-ui, sans-serif",
    "font-text": "'Ploni', system-ui, sans-serif",
    "font-headline": { "value": "'Ploni', system-ui, sans-serif", "note": "headlines: Ploni Light, set large and tight" }
  },

  "size": {
    "fs-h1": { "value": "clamp(3rem, 1.9rem + 4.6vw, 6.25rem)", "note": "48 → 97: page titles, the big figures" },
    "fs-h2": { "value": "clamp(2.5rem, 1.6rem + 3.2vw, 4.5rem)", "note": "40 → 72: section titles, the home headline" },
    "fs-h3": { "value": "clamp(2rem, 1.45rem + 1.9vw, 3.25rem)", "note": "32 → 51: destination rows, lead cards, step titles" },
    "fs-h4": { "value": "clamp(1.625rem, 1.3rem + 1vw, 2.25rem)", "note": "26 → 35: card titles, steps, quotes" },
    "fs-title": { "value": "1.5rem", "note": "24: small titles in Ploni Tzar" },
    "fs-lead": { "value": "1.25rem", "note": "20: ledes, prose, names in lists" },
    "fs-base": { "value": "1.0625rem", "note": "17: body, buttons, legends" },
    "fs-small": { "value": ".9375rem", "note": "15: captions, meta" },
    "fs-micro": { "value": ".8125rem", "note": "13: map labels, table heads" },
    "fs-mega": { "value": "clamp(4.25rem, 14vw, 14.5rem)", "note": "the footer's last legend, the one exception" }
  },

  "weight": {
    "fw-light": 300,
    "fw-regular": 400,
    "fw-medium": 500,
    "fw-bold": 700
  },

  "leading": {
    "lh-display": ".92",
    "lh-heading": "1.02",
    "lh-title": "1.15",
    "lh-text": "1.6",
    "lh-prose": "1.7"
  },

  "tracking": {
    "track-headline": "-0.045em",
    "track-heading": "-0.03em",
    "track-title": "-0.01em"
  },

  "radius": {
    "r-pill": "999px",
    "r-frame": { "value": "26px", "note": "the frame around the home map" },
    "r-plate": "10px",
    "r-small": "6px"
  },

  "line": {
    "frame": { "value": "12px", "note": "the home map's inset from the window" },
    "keyline": "2px",
    "keyline-inset": "5px"
  },

  "layout": {
    "container": "1320px",
    "gutter": "clamp(16px, 4vw, 56px)",
    "header-h": "84px"
  },

  "ease": {
    "ease-out": "cubic-bezier(.16, 1, .3, 1)",
    "ease-in-out": "cubic-bezier(.76, 0, .24, 1)"
  }
}
